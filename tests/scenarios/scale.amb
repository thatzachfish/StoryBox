# StoryBox has no scale editing: in ACTS a white key is an act or a story, a black key a track; ALGORITHM is Energy;
# Setup's first knob the root
wait 300
expect pool 0x6AD
# key 1 (F#3) is the pad's track: a tap mutes it, the scale stays
tapkey 13
expect pool 0x6AD
expect mutes 1
tapkey 13
expect mutes 0
# ALGORITHM: Energy (the player's, 50 as the act has it)
expect par31 50
turn ALGO 1
expect par31 51
turn ALGO -1
expect par31 50
# the root up a tone (Setup page, KNOB 1)
tap GLO
spin K1 2
expect par19 4
tap HOME
expect view 0
expect pool 0x6AD
expect dirty 1
wait 300
shot e_root.png
