# Bluetooth audio (0.6): the Bluetooth page (after System) looks for speakers; SAVE connects the one picked, again
# lets it go; Sound to: the FM-1's own and back; a speaker lost is said; at power-on nothing is called
wait 300
listen
tap GLO
turn SELECT 2
wait 100
expect view 12
bta add Kitchen
bta add Headphones
wait 1500
expect bta 2
shot bt-found.png
spin K2 1
wait 100
said PICK Headphones
tap SAVE
wait 600
expect bta 7
said PLAYING ON Headphones
expect bta_known 1
shot bt-playing.png
spin K3 -1
wait 100
expect btout 0
said PLAY ON FM-1
spin K3 1
wait 100
expect btout 1
# let go, then the speaker leaves while playing
tap SAVE
wait 100
said LET GO Headphones
tap SAVE
wait 600
expect bta 7
bta drop Headphones
wait 100
said SPEAKER LOST Headphones
# back again: at power-on it is not called by itself (0.6.9: a crash connecting at power-on would repeat)
bta add Headphones
tap SAVE
reboot
wait 300
listen
wait 3200
expect bta_known 1
# held SAVE on the page: forgotten
tap GLO
turn SELECT 2
wait 100
press SAVE
wait 1700
release SAVE
said FORGOTTEN Headphones
expect bta_known 0
# off: the radio quiet, the page says so
spin K4 -1
wait 100
said BLUETOOTH OFF
shot bt-off.png
